#!/usr/bin/env bash

## Waybar module : neo brutalism theme icon (click : theme panel, right click : light/dark)

DIR="$HOME/.config/sway"
MODE="$("$DIR"/theme/neobrutal.sh status)"
source "$DIR/theme/neobrutal/$MODE.bash"

SUN=$'\U000F05A8'   # nf-md-white_balance_sunny
MOON=$'\U000F0594'  # nf-md-weather_night

[[ "$MODE" == "light" ]] && text="$SUN" || text="$MOON"

jq -cn --arg text "$text" --arg class "$MODE" \
	'{text: $text, class: $class, alt: $class}'
