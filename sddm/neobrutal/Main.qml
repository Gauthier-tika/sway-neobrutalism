// Neo Brutalism SDDM greeter — palette generated by sddm/install.sh,
// light/dark mode and main/accent colors synced by config/sway/theme/neobrutal.sh (theme.conf.user).

import QtQuick

Rectangle {
    id: root

    width: Screen.width
    height: Screen.height
    color: t.bg

    // ------------------------------------------------------------ theme --
    QtObject {
        id: t

        readonly property bool dark: (config.mode || "dark") === "dark"
        function pal(key, fallback) {
            const v = config[(dark ? "dark_" : "light_") + key];
            return v ? v : fallback;
        }

        readonly property color bg: pal("bg", dark ? "#2A2B30" : "#FFF4E0")
        readonly property color grid: pal("grid", dark ? "#34353B" : "#EADCC0")
        readonly property color surface: pal("surface", dark ? "#3B3D44" : "#FFFFFF")
        readonly property color fg: pal("fg", dark ? "#FFF4E0" : "#000000")
        readonly property color ink: pal("ink", "#000000")
        readonly property color border: pal("border", "#000000")
        readonly property color shadow: pal("shadow", "#000000")
        readonly property color muted: pal("muted", dark ? "#A09A8E" : "#7A7468")
        readonly property color main: config.main || pal("main", "#FFDC58")
        readonly property color accent: config.accent || pal("accent", dark ? "#FFDC58" : "#FF6B6B")
        readonly property color red: pal("red", "#FF6B6B")
        readonly property color blue: pal("blue", "#88AAEE")
        readonly property color green: pal("green", "#A3E636")
        readonly property color purple: pal("purple", "#A388EE")
        readonly property color orange: pal("orange", "#FF9F45")
        readonly property color pink: pal("pink", "#FF90E8")

        readonly property string font: config.font || "JetBrainsMono Nerd Font"
        readonly property int bw: 3          // card border
        readonly property int bwSmall: 2     // control border
        readonly property int shadowOff: 8   // card shadow offset
        readonly property int pressOff: 4    // control shadow offset

        // text color on top of a given fill
        function onFill(fill) {
            return (Qt.colorEqual(fill, surface) || Qt.colorEqual(fill, bg)) ? fg : ink;
        }
        function hover(fill) {
            return Qt.darker(fill, dark ? 0.85 : 1.06);
        }
    }

    // ------------------------------------------------------- components --
    component BText: Text {
        color: t.fg
        font.family: t.font
        font.pixelSize: 15
        font.weight: Font.Bold
        elide: Text.ElideRight
        verticalAlignment: Text.AlignVCenter
    }

    // block with a hard offset shadow
    component Card: Item {
        id: card
        property color fill: t.surface
        property int off: t.shadowOff
        property int bw: t.bw
        default property alias content: face.data

        Rectangle {
            x: card.off
            y: card.off
            width: face.width
            height: face.height
            color: t.shadow
        }
        Rectangle {
            id: face
            width: card.width - card.off
            height: card.height - card.off
            color: card.fill
            border.width: card.bw
            border.color: t.border
        }
    }

    // pressable chip : the face slides onto its shadow when pressed
    component Chip: Item {
        id: chip
        property string text: ""
        property string icon: ""
        property color fill: t.surface
        property color activeFill: t.main
        property bool active: false
        property int fontSize: 15
        property int padX: 16
        property int off: t.pressOff
        property alias faceItem: face
        signal clicked

        readonly property bool down: ma.pressed
        readonly property color faceColor: active ? activeFill
                                          : (ma.containsMouse || activeFocus) ? t.hover(fill) : fill

        implicitWidth: row.implicitWidth + 2 * padX + off
        implicitHeight: 42 + off
        activeFocusOnTab: true
        Keys.onReturnPressed: clicked()
        Keys.onEnterPressed: clicked()
        Keys.onSpacePressed: clicked()

        Rectangle {
            x: chip.off
            y: chip.off
            width: chip.width - chip.off
            height: chip.height - chip.off
            color: t.shadow
        }
        Rectangle {
            id: face
            x: chip.down ? chip.off : 0
            y: chip.down ? chip.off : 0
            width: chip.width - chip.off
            height: chip.height - chip.off
            color: chip.faceColor
            border.width: chip.activeFocus ? t.bw : t.bwSmall
            border.color: t.border

            Row {
                id: row
                anchors.centerIn: parent
                spacing: 8
                BText {
                    visible: chip.icon !== ""
                    text: chip.icon
                    color: t.onFill(chip.faceColor)
                    font.pixelSize: chip.fontSize + 3
                }
                BText {
                    visible: chip.text !== ""
                    text: chip.text
                    color: t.onFill(chip.faceColor)
                    font.pixelSize: chip.fontSize
                    font.weight: Font.ExtraBold
                }
            }
        }
        MouseArea {
            id: ma
            anchors.fill: parent
            hoverEnabled: true
            cursorShape: Qt.PointingHandCursor
            onClicked: chip.clicked()
        }
    }

    component SectionLabel: BText {
        color: t.muted
        font.pixelSize: 12
        font.weight: Font.ExtraBold
        font.letterSpacing: 1.5
    }

    // ------------------------------------------------------------- state --
    property int userIndex: userModel.lastIndex >= 0 ? userModel.lastIndex : 0
    property int sessionIndex: sessionModel.lastIndex >= 0 ? sessionModel.lastIndex : 0
    property bool failed: false
    property bool busy: false

    // itemAt() isn't reactive: these bindings also depend on the Repeater counts
    // so they re-evaluate once the delegates exist. doLogin() reads them fresh.
    readonly property string userName: userModel.count > 0
        ? (userRep.count > 0 && userRep.itemAt(userIndex) ? userRep.itemAt(userIndex).uname : "")
        : userField.text
    readonly property string sessionName: sessRep.count > 0 && sessRep.itemAt(sessionIndex)
        ? sessRep.itemAt(sessionIndex).sname : "—"

    function currentUser() {
        if (userRep.count === 0)
            return userField.text;
        const it = userRep.itemAt(userIndex);
        return it ? it.uname : "";
    }

    function doLogin() {
        const user = currentUser();
        if (busy || user === "")
            return;
        busy = true;
        failed = false;
        sddm.login(user, password.text, sessionIndex);
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            root.busy = false;
            root.failed = true;
            password.text = "";
            password.forceActiveFocus();
            shake.restart();
        }
        function onLoginSucceeded() {
            root.busy = false;
        }
    }

    // -------------------------------------------------------- wallpaper --
    Canvas {
        anchors.fill: parent
        onPaint: {
            const ctx = getContext("2d");
            // dot grid : one round dot every 32 px
            const step = 32, r = 2.5;
            ctx.fillStyle = Qt.darker(t.grid, t.dark ? 0.625 : 1.12);
            ctx.beginPath();
            for (let x = step / 2; x < width; x += step)
                for (let y = step / 2; y < height; y += step) {
                    ctx.moveTo(x + r, y);
                    ctx.arc(x, y, r, 0, 2 * Math.PI);
                }
            ctx.fill();
        }
        Connections {
            target: t
            function onGridChanged() { parent.requestPaint(); }
        }
    }

    MouseArea {
        anchors.fill: parent
        onClicked: { sessionPopup.open = false; password.forceActiveFocus(); }
    }

    // --------------------------------------------------------- top left --
    Card {
        visible: sddm.hostName !== ""
        x: 32
        y: 32
        width: hostRow.implicitWidth + 32 + t.pressOff
        height: 42 + t.pressOff
        off: t.pressOff
        bw: t.bwSmall
        fill: t.purple
        Row {
            id: hostRow
            anchors.centerIn: parent
            spacing: 8
            BText { text: "󰌢"; color: t.ink; font.pixelSize: 18 }
            BText { text: sddm.hostName; color: t.ink; font.weight: Font.ExtraBold }
        }
    }

    // ------------------------------------------------------ center stack --
    Column {
        id: stack
        anchors.centerIn: parent
        anchors.verticalCenterOffset: -20
        spacing: 28

        // clock
        Item {
            width: loginCard.width
            height: clockCard.height

            Card {
                id: clockCard
                anchors.horizontalCenter: parent.horizontalCenter
                width: clock.implicitWidth + 56 + t.shadowOff
                height: clock.implicitHeight + 16 + t.shadowOff
                fill: t.main
                BText {
                    id: clock
                    anchors.centerIn: parent
                    color: t.ink
                    font.pixelSize: 96
                    font.weight: Font.ExtraBold
                    text: Qt.formatTime(now.date, "HH:mm")
                }
            }

            // sticker
            Card {
                x: clockCard.x + clockCard.width - width / 2 - 10
                y: -14
                rotation: 6
                width: dateText.implicitWidth + 24 + t.pressOff
                height: 34 + t.pressOff
                off: t.pressOff
                bw: t.bwSmall
                fill: t.pink
                BText {
                    id: dateText
                    anchors.centerIn: parent
                    color: t.ink
                    font.pixelSize: 13
                    font.weight: Font.ExtraBold
                    text: Qt.locale("en_US").toString(now.date, "dddd, MMMM d").toUpperCase()
                }
            }
        }

        // login form
        Card {
            id: loginCard
            width: 520
            height: header.height + body.implicitHeight + 2 * 24 + t.bw + t.shadowOff

            // header strip
            Rectangle {
                id: header
                width: parent.width
                height: 48
                color: root.failed ? t.red : t.main
                border.width: t.bw
                border.color: t.border
                BText {
                    x: 20
                    height: parent.height
                    text: root.failed ? "\u{f0026}  ACCESS DENIED" : "\u{f0342}  LOGIN"
                    color: t.ink
                    font.pixelSize: 16
                    font.weight: Font.ExtraBold
                    font.letterSpacing: 1
                }
                Row {
                    anchors.right: parent.right
                    anchors.rightMargin: 18
                    anchors.verticalCenter: parent.verticalCenter
                    spacing: 7
                    Repeater {
                        model: 3
                        Rectangle {
                            required property int index
                            width: 14; height: 14
                            color: [t.red, t.main, t.green][index]
                            border.width: t.bwSmall
                            border.color: t.border
                        }
                    }
                }
            }

            Column {
                id: body
                x: 24
                y: header.height + 24
                width: parent.width - 48
                spacing: 12

                // users
                SectionLabel { text: "USER" }

                Flow {
                    width: parent.width
                    spacing: 12
                    visible: userModel.count > 0

                    Repeater {
                        id: userRep
                        model: userModel

                        Chip {
                            id: userChip
                            required property int index
                            required property string name
                            required property string realName
                            required property string icon
                            readonly property string uname: name
                            readonly property bool selected: index === root.userIndex

                            active: selected
                            activeFill: t.main
                            width: Math.min(implicitWidth, body.width)
                            implicitWidth: 52 + 12 + userLabel.implicitWidth + 24 + off
                            implicitHeight: 52 + off
                            onClicked: {
                                root.userIndex = index;
                                root.failed = false;
                                password.forceActiveFocus();
                            }

                            Rectangle {
                                id: avatar
                                parent: userChip.faceItem
                                x: 6; y: 6
                                width: 40; height: 40
                                color: [t.blue, t.green, t.orange, t.purple, t.pink][userChip.index % 5]
                                border.width: t.bwSmall
                                border.color: t.border
                                clip: true
                                BText {
                                    anchors.centerIn: parent
                                    visible: avatarImg.status !== Image.Ready
                                    text: (userChip.realName || userChip.name).charAt(0).toUpperCase()
                                    color: t.ink
                                    font.pixelSize: 20
                                    font.weight: Font.ExtraBold
                                }
                                Image {
                                    id: avatarImg
                                    anchors.fill: parent
                                    anchors.margins: t.bwSmall
                                    fillMode: Image.PreserveAspectCrop
                                    sourceSize: Qt.size(80, 80)
                                    source: userChip.icon === "" ? ""
                                            : userChip.icon.startsWith("/") ? "file://" + userChip.icon : userChip.icon
                                }
                            }
                            BText {
                                id: userLabel
                                parent: userChip.faceItem
                                x: avatar.x + avatar.width + 12
                                width: userChip.faceItem.width - x - 12
                                height: userChip.faceItem.height
                                text: userChip.realName || userChip.name
                                color: t.onFill(userChip.faceColor)
                                font.weight: Font.ExtraBold
                            }
                        }
                    }
                }

                // fallback when no user is listed
                Rectangle {
                    visible: userModel.count === 0
                    width: parent.width - t.pressOff
                    height: 46
                    color: t.surface
                    border.width: userField.activeFocus ? t.bw : t.bwSmall
                    border.color: t.border
                    TextInput {
                        id: userField
                        anchors.fill: parent
                        anchors.leftMargin: 14
                        anchors.rightMargin: 14
                        verticalAlignment: TextInput.AlignVCenter
                        color: t.fg
                        font.family: t.font
                        font.pixelSize: 16
                        font.weight: Font.Bold
                        selectionColor: t.main
                        selectedTextColor: t.ink
                        KeyNavigation.tab: password
                        BText {
                            visible: !parent.text
                            text: "username"
                            color: t.muted
                            height: parent.height
                        }
                    }
                }

                Item { width: 1; height: 4 }

                // password
                SectionLabel { text: "PASSWORD" }

                Item {
                    width: parent.width
                    height: 52 + t.pressOff

                    transform: Translate { id: shakeT }
                    SequentialAnimation {
                        id: shake
                        loops: 2
                        NumberAnimation { target: shakeT; property: "x"; to: -12; duration: 45 }
                        NumberAnimation { target: shakeT; property: "x"; to: 12; duration: 90 }
                        NumberAnimation { target: shakeT; property: "x"; to: 0; duration: 45 }
                    }

                    Rectangle {
                        x: t.pressOff
                        y: t.pressOff
                        width: pwFace.width
                        height: pwFace.height
                        color: password.activeFocus ? t.shadow : "transparent"
                    }
                    Rectangle {
                        id: pwFace
                        width: parent.width - t.pressOff
                        height: parent.height - t.pressOff
                        color: root.failed ? Qt.tint(t.surface, Qt.alpha(t.red, 0.25)) : t.surface
                        border.width: password.activeFocus ? t.bw : t.bwSmall
                        border.color: t.border

                        BText {
                            id: lockIcon
                            x: 14
                            height: parent.height
                            text: root.failed ? "\u{f0026}" : "\u{f033e}"
                            color: root.failed ? t.red : t.fg
                            font.pixelSize: 18
                        }

                        TextInput {
                            id: password
                            x: lockIcon.x + 30
                            width: eye.x - x - 10
                            height: parent.height
                            verticalAlignment: TextInput.AlignVCenter
                            clip: true
                            focus: true
                            echoMode: eye.active ? TextInput.Normal : TextInput.Password
                            passwordCharacter: "■"
                            passwordMaskDelay: 0
                            color: t.fg
                            font.family: t.font
                            font.pixelSize: echoMode === TextInput.Password ? 14 : 17
                            font.letterSpacing: echoMode === TextInput.Password ? 3 : 0
                            font.weight: Font.Bold
                            selectionColor: t.main
                            selectedTextColor: t.ink
                            cursorDelegate: Rectangle {
                                width: 10
                                color: t.accent
                                visible: password.activeFocus
                                SequentialAnimation on opacity {
                                    loops: Animation.Infinite
                                    running: password.activeFocus
                                    PropertyAnimation { to: 0; duration: 0 }
                                    PauseAnimation { duration: 500 }
                                    PropertyAnimation { to: 1; duration: 0 }
                                    PauseAnimation { duration: 500 }
                                }
                            }
                            onTextEdited: root.failed = false
                            Keys.onReturnPressed: root.doLogin()
                            Keys.onEnterPressed: root.doLogin()
                            Keys.onEscapePressed: { text = ""; root.failed = false; }
                            Keys.onUpPressed: root.sessionIndex = (root.sessionIndex + sessRep.count - 1) % sessRep.count
                            Keys.onDownPressed: root.sessionIndex = (root.sessionIndex + 1) % sessRep.count

                            BText {
                                visible: !parent.text
                                x: 16
                                height: parent.height
                                text: root.failed ? "wrong password, try again" : "••••••••"
                                color: root.failed ? t.red : t.muted
                                font.weight: Font.Bold
                            }
                        }

                        Chip {
                            id: eye
                            x: parent.width - width - 8
                            anchors.verticalCenter: parent.verticalCenter
                            anchors.verticalCenterOffset: off / 2
                            implicitHeight: 32 + off
                            padX: 8
                            off: 3
                            fontSize: 13
                            icon: active ? "󰈈" : "󰈉"
                            property bool toggled: false
                            active: toggled
                            activeFocusOnTab: false
                            onClicked: { toggled = !toggled; password.forceActiveFocus(); }
                        }
                    }
                }

                // caps lock
                Card {
                    visible: keyboard.capsLock
                    width: capsText.implicitWidth + 24 + t.pressOff
                    height: 30 + t.pressOff
                    off: t.pressOff
                    bw: t.bwSmall
                    fill: t.orange
                    BText {
                        id: capsText
                        anchors.centerIn: parent
                        text: "󰪛  CAPS LOCK ON"
                        color: t.ink
                        font.pixelSize: 12
                        font.weight: Font.ExtraBold
                    }
                }

                Item { width: 1; height: 4 }

                // session + login
                Item {
                    width: parent.width
                    height: 46 + t.pressOff
                    z: 10

                    Item {
                        id: sessionPopup
                        property bool open: false
                        width: parent.width - loginBtn.width - 12
                        height: parent.height

                        Chip {
                            id: sessionHead
                            width: parent.width
                            active: sessionPopup.open
                            onClicked: sessionPopup.open = !sessionPopup.open
                            Keys.onUpPressed: root.sessionIndex = (root.sessionIndex + sessRep.count - 1) % sessRep.count
                            Keys.onDownPressed: root.sessionIndex = (root.sessionIndex + 1) % sessRep.count
                            Keys.onEscapePressed: sessionPopup.open = false

                            BText {
                                parent: sessionHead.faceItem
                                x: 14
                                width: parent.width - 50
                                height: parent.height
                                text: "󰍹  " + root.sessionName
                                color: t.onFill(sessionHead.faceColor)
                                font.weight: Font.ExtraBold
                            }
                            BText {
                                parent: sessionHead.faceItem
                                x: parent.width - 30
                                height: parent.height
                                text: sessionPopup.open ? "󰅃" : "󰅀"
                                color: t.onFill(sessionHead.faceColor)
                                font.pixelSize: 18
                            }
                        }

                        Card {
                            visible: sessionPopup.open
                            y: sessionHead.height + 4
                            width: parent.width
                            height: sessList.implicitHeight + 2 * t.bwSmall + t.pressOff
                            off: t.pressOff
                            bw: t.bwSmall

                            Column {
                                id: sessList
                                x: t.bwSmall
                                y: t.bwSmall
                                width: parent.width - 2 * t.bwSmall

                                Repeater {
                                    id: sessRep
                                    model: sessionModel

                                    Rectangle {
                                        required property int index
                                        required property string name
                                        readonly property string sname: name
                                        readonly property bool current: index === root.sessionIndex
                                        width: sessList.width
                                        height: 38
                                        color: current ? t.main : rowMa.containsMouse ? t.bg : t.surface

                                        Rectangle {
                                            visible: index > 0
                                            width: parent.width
                                            height: t.bwSmall
                                            color: t.border
                                        }
                                        BText {
                                            anchors.fill: parent
                                            anchors.leftMargin: 14
                                            anchors.rightMargin: 14
                                            text: (parent.current ? "● " : "   ") + parent.name
                                            color: parent.current ? t.ink : t.fg
                                        }
                                        MouseArea {
                                            id: rowMa
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: {
                                                root.sessionIndex = parent.index;
                                                sessionPopup.open = false;
                                                password.forceActiveFocus();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Chip {
                        id: loginBtn
                        anchors.right: parent.right
                        fill: t.green
                        text: root.busy ? "…" : "LOG IN"
                        icon: "󰁔"
                        padX: 20
                        onClicked: root.doLogin()
                    }
                }
            }
        }
    }

    // ------------------------------------------------------ bottom right --
    Row {
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.margins: 32
        spacing: 14

        Chip {
            visible: sddm.canSuspend
            fill: t.blue
            icon: "󰤄"
            text: "SUSPEND"
            onClicked: sddm.suspend()
        }
        Chip {
            visible: sddm.canReboot
            fill: t.orange
            icon: "󰜉"
            text: "REBOOT"
            onClicked: sddm.reboot()
        }
        Chip {
            visible: sddm.canPowerOff
            fill: t.red
            icon: "󰐥"
            text: "SHUT DOWN"
            onClicked: sddm.powerOff()
        }
    }

    // ------------------------------------------------------- bottom left --
    BText {
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        anchors.margins: 36
        height: 42
        text: "TAB  navigate   ·   ↵  log in   ·   ↑↓  session"
        color: t.muted
        font.pixelSize: 12
    }

    QtObject {
        id: now
        property var date: new Date()
    }
    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: now.date = new Date()
    }

    Component.onCompleted: password.forceActiveFocus()
}
