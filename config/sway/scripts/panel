#!/usr/bin/env bash

## Toggle a Quickshell panel : panel bluetooth|audio|brightness|wifi|calendar|theme
## Falls back to classic tools when quickshell isn't installed.

QS_DIR="$HOME/.config/sway/quickshell"

fallback() {
	case "$1" in
		bluetooth)  exec blueman-manager ;;
		audio)      exec pavucontrol ;;
		wifi)       exec nm-connection-editor ;;
		brightness) exec "$HOME/.config/sway/scripts/brightness" --get ;;
		theme)      exec "$HOME/.config/sway/theme/neobrutal.sh" toggle ;;
		calendar)   notify-send "$(date '+%A %d %B %Y')" "$(cal -m | sed 's/_\x08//g')" ;;
	esac
}

if ! command -v qs >/dev/null 2>&1; then
	fallback "$1"
	exit
fi

qs -p "$QS_DIR" ipc call panel toggle "$1" 2>/dev/null || {
	# not running yet : start it, then retry
	QT_QPA_PLATFORM=wayland qs -p "$QS_DIR" -n -d
	sleep 0.6
	qs -p "$QS_DIR" ipc call panel toggle "$1"
}
