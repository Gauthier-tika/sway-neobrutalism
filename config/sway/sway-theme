##-- Style (Neo Brutalism) ---------------
default_border pixel 3
default_floating_border pixel 3
smart_borders no_gaps

titlebar_border_thickness 3
titlebar_padding 8 4
title_align left

gaps inner 20
gaps outer 8

##-- Colors + GTK ------------------------
## Generated by ~/.config/sway/theme/neobrutal.sh (light | dark | toggle)
include ~/.config/sway/sway-colors

## Toggle light/dark
bindsym $mod+Shift+t exec ~/.config/sway/theme/neobrutal.sh toggle
