#!/usr/bin/env bash

iDIR="$HOME/.config/sway/mako/icons"

# Get brightness
get_backlight() {
	LIGHT=$("$HOME/.config/sway/scripts/backlight" get)
	echo "${LIGHT}%"
}

# Get icons
get_icon() {
	backlight="$(get_backlight)"
	current="${backlight%%%}"
	if [[ ("$current" -ge "0") && ("$current" -le "20") ]]; then
		icon="$iDIR"/brightness-20.png
	elif [[ ("$current" -ge "20") && ("$current" -le "40") ]]; then
		icon="$iDIR"/brightness-40.png
	elif [[ ("$current" -ge "40") && ("$current" -le "60") ]]; then
		icon="$iDIR"/brightness-60.png
	elif [[ ("$current" -ge "60") && ("$current" -le "80") ]]; then
		icon="$iDIR"/brightness-80.png
	elif [[ ("$current" -ge "80") && ("$current" -le "100") ]]; then
		icon="$iDIR"/brightness-100.png
	fi
}

# 20-cell block bar for the notification body : bar <percent>
bar() {
	local n=$(( ($1 + 2) / 5 )) i out=""
	(( n > 20 )) && n=20; (( n < 0 )) && n=0
	for ((i = 0; i < 20; i++)); do (( i < n )) && out+="█" || out+="░"; done
	printf '%s  %s%%' "$out" "$1"
}

# Notify
notify_user() {
	local b; b="$("$HOME/.config/sway/scripts/backlight" get)"
	notify-send -h string:x-canonical-private-synchronous:sys-notify-backlight -u low -c osd -i "$icon" "Brightness" "$(bar "$b")"
}

# Increase brightness
inc_backlight() {
	"$HOME/.config/sway/scripts/backlight" inc 5 && get_icon && notify_user
}

# Decrease brightness
dec_backlight() {
	"$HOME/.config/sway/scripts/backlight" dec 5 && get_icon && notify_user
}

# Execute accordingly
if [[ "$1" == "--get" ]]; then
	get_backlight
elif [[ "$1" == "--inc" ]]; then
	inc_backlight
elif [[ "$1" == "--dec" ]]; then
	dec_backlight
else
	get_backlight
fi
